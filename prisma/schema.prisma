generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // app connection (pooled on serverless hosts)
  directUrl = env("DIRECT_URL") // direct connection, used by prisma migrate
}

enum Role {
  ADMIN
  TEACHER
  LIBRARIAN
  STUDENT
}

enum MemberType {
  STUDENT // นักเรียน
  TEACHER // ครู
  SUPERVISOR // ศึกษานิเทศก์
  GENERAL // บุคคลทั่วไป
}

enum CreatorStatus {
  NONE
  PENDING // asked to become a course creator, waiting for an admin
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique // log in without an e-mail (students)
  name         String // full display name (prefix + first + last as typed)
  memberType   MemberType @default(GENERAL)
  prefix       String? // คำนำหน้า
  firstName    String?
  lastName     String?
  phone        String?
  schoolId     String? // teachers / students pick their school from the directory
  memberSchool School?  @relation("SchoolMembers", fields: [schoolId], references: [id], onDelete: SetNull)
  organization String? // supervisors / general: home agency
  position     String? // ตำแหน่ง/วิทยฐานะ
  gradeLevel   String? // students: ชั้น
  creatorStatus CreatorStatus @default(NONE)
  creatorReason String?
  devices       TrustedDevice[]
  mediaCreated  Media[]         @relation("MediaCreator")
  mediaLikes    MediaLike[]
  reviewerAreas AreaReviewer[]
  registrationCodeId String? // the sign-up code this member used (for the per-code member list)
  registrationCode   RegistrationCode? @relation("CodeUsers", fields: [registrationCodeId], references: [id], onDelete: SetNull)
  // profile picture: either an uploaded, already-cropped square (avatarKey) or a public Google Drive file
  // shown through Drive's thumbnail with a stored circular crop window (centre cx/cy 0..1 of the image, zoom >= 1)
  avatarKey     String?
  avatarDriveId String?
  avatarCx      Float     @default(0.5)
  avatarCy      Float     @default(0.5)
  avatarZoom    Float     @default(1)
  avatarAspect  Float     @default(1) // width / height of the Drive thumbnail
  passwordHash String
  role         Role     @default(STUDENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]
  banners     Banner[]     @relation("BannerCreator")
  school      School?      @relation("SchoolAccount") // set when this account manages a school
  mustChangePassword Boolean @default(false) // temporary password issued by an admin/import
}

/// Admin-issued sign-up code. Redeemed atomically (see src/lib/registration.ts) so a code with 1 use left
/// can only be used by one of two people signing up at the same moment.
model RegistrationCode {
  id          String     @id @default(cuid())
  code        String     @unique // normalised: upper-case, no dashes
  label       String
  memberType  MemberType
  schoolId    String? // locks the school of everyone who uses the code
  school      School?    @relation("CodeSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  maxUses     Int? // null = unlimited
  usedCount   Int        @default(0)
  active      Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())
  users       User[]     @relation("CodeUsers")

  @@index([active, expiresAt])
}

/// A phone that signed in with a password once and then chose a 6-digit PIN. The PIN only works together
/// with the random device token kept on that phone (only its hash is stored here).
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  pinHash    String
  failCount  Int      @default(0)
  label      String // e.g. "iPhone · Safari"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ---------- Media library (คลังสื่อ) ----------
enum MediaStatus {
  DRAFT
  PENDING // waiting for a reviewer
  PUBLISHED
  REJECTED
}

enum MediaItemKind {
  YOUTUBE
  DRIVE_FILE // a public Google Drive file (PDF, image, video, office file)
  GOOGLE_DOC // Docs / Slides / Sheets / Forms
  APPS_SCRIPT
  HTML // pasted HTML application, served sandboxed
  EMBED // a provider on the allow-list (Canva, Wordwall, ...)
  LINK // any other https page: opened in a new tab, never framed
  UPLOAD // a file in our storage (only while the admin allows uploads)
}

/// The 8 learning areas + extras. Editable by an admin.
model LearningArea {
  id        String  @id
  slug      String  @unique
  name      String
  icon      String  @default("book-open") // icon KEY from src/lib/icon-paths.ts (drawn as a line icon)
  color     String  @default("#0052FF")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media     Media[]
  reviewers AreaReviewer[]
}

model MediaType {
  id        String  @id
  slug      String  @unique
  name      String
  icon      String  @default("file-text")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media Media[]
}

model EducationLevel {
  id        String  @id
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media MediaLevel[]
}

model Media {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  authorName  String? // free-text credit when an admin posts on someone else's behalf
  areaId      String
  area        LearningArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  typeId      String?
  type        MediaType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  levels      MediaLevel[]
  tags        String[]
  // cover: an uploaded 16:9 WebP, or a public Drive file shown through its thumbnail (focus point = where to crop)
  coverKey     String?
  coverDriveId String?
  coverFx      Float   @default(0.5)
  coverFy      Float   @default(0.5)

  status       MediaStatus @default(DRAFT)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  pinned       Boolean     @default(false)

  createdById String
  createdBy   User   @relation("MediaCreator", fields: [createdById], references: [id], onDelete: Cascade)

  viewCount     Int @default(0)
  likeCount     Int @default(0)
  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MediaItem[]
  likes MediaLike[]
  views MediaViewDaily[]

  @@index([status, publishedAt])
  @@index([areaId, status])
  @@index([createdById])
  @@index([status, viewCount])
}

model MediaLevel {
  mediaId String
  levelId String
  media   Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  level   EducationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([mediaId, levelId])
}

/// One thing to open/download. The first item (by sortOrder) is shown in the viewer, the rest are listed as attachments.
model MediaItem {
  id         String        @id @default(cuid())
  mediaId    String
  media      Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind       MediaItemKind
  label      String        @default("")
  url        String? // normalised link (YOUTUBE, DRIVE_FILE, GOOGLE_DOC, APPS_SCRIPT, EMBED, LINK)
  storageKey String? // UPLOAD
  mimeType   String?
  sizeBytes  Int?
  html       String? // HTML (<= 500 KB)
  sortOrder  Int           @default(0)

  @@index([mediaId, sortOrder])
}

model MediaLike {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([mediaId])
}

/// Views per day: lets "most viewed in the last 30 days" differ from "most viewed ever".
model MediaViewDaily {
  mediaId String
  day     DateTime @db.Date
  views   Int      @default(0)
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, day])
  @@index([day])
}

/// Members the admin appointed to approve media of one learning area.
model AreaReviewer {
  userId String
  areaId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   LearningArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
}

// ---------- LMS ----------
model Course {
  id          String  @id @default(cuid())
  title       String
  description String?
  published   Boolean @default(false)
  createdAt   DateTime @default(now())

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  content  String? // markdown
  videoUrl String?

  @@index([courseId, position])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Int      @default(0) // 0-100
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// ---------- Site content ----------
model Banner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageKey   String? // storage key, e.g. banners/<uuid>.webp
  linkUrl    String?
  buttonText String?
  bgColor    String    @default("#EAF0FF")
  showText   Boolean   @default(true) // overlay title/subtitle/button on the image
  active     Boolean   @default(true)
  sortOrder  Int       @default(0)
  startAt    DateTime?
  endAt      DateTime?
  newTab     Boolean   @default(false) // open the link in a new tab (always true for external links)
  sourceUrl  String? // public Google Drive link the image was taken from (a snapshot is stored)
  pinned     Boolean   @default(false) // admin-only: pinned slides always come first
  published  Boolean   @default(true) // approved by an admin; slides made by others start as false
  createdById String?
  createdBy  User?     @relation("BannerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, sortOrder])
}

// One row (id = "main"): identity of this deployment/district. Another district
// gets its own database (or, later, its own row keyed by area).
model SiteSetting {
  id             String   @id @default("main")
  systemName     String   @default("Anyware Anytime")
  areaName       String   @default("")
  tagline        String   @default("")
  logoKey        String?
  logoBackdrop   Boolean  @default(false) // white rounded plate behind the hero logo
  heroVideoKey   String?
  heroBgColor    String   @default("#0B2A6F") // behind / under the video
  overlayOpacity Int      @default(45) // 0-90, dark layer over the video
  fadeSeconds    Float    @default(1.5) // video fade in/out at each loop
  // recommended-slides slideshow look
  slideRadius    Int      @default(0) // corner radius px, 0-32 (ignored when full width)
  slideEffect    String   @default("slide") // slide | fade | zoom | wipe | blur
  slideInterval  Float    @default(5) // seconds per slide
  slideLayout    String   @default("contained") // contained | full
  slideAutoplay  Boolean  @default(true)
  slideArrows    Boolean  @default(true)
  slideRandom    Boolean  @default(false) // use every effect, picked at random for each change
  slideShuffle   Boolean  @default(false) // shuffle slide order on each page load (pinned stay first)
  requireRegistrationCode Boolean @default(true) // sign-up only with an admin-issued code (turn off to allow open sign-up)
  allowServerUploads Boolean @default(false) // may members upload images to our storage? (off until there is a server; Drive links work without)
  // footer / contact page
  contactAddress String?
  contactPhone   String?
  contactEmail   String?
  facebookUrl    String?
  youtubeUrl     String?
  lineUrl        String?
  // visitor counter
  counterSince   DateTime @default(now()) // "counting since" date shown in the footer (editable)
  counterBase    Int      @default(0) // starting number (e.g. carried over from an older site)
  showVisits     Boolean  @default(true)
  showOnline     Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

// Home page blocks below the hero. A row only exists once an admin edits/moves it;
// missing rows fall back to the defaults in src/lib/sections.ts.
model HomeSection {
  key        String   @id // recommended | categories | media | courses
  title      String
  subtitle   String   @default("")
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  align      String   @default("left") // left | center | right (heading position)
  titleSize  String   @default("md") // sm | md | lg
  titleColor String   @default("#1E1E1E")
  bgColor    String? // solid colour, or gradient start
  bgMode      String  @default("none") // none | solid | gradient | image
  bgColor2    String? // gradient end
  bgDirection String  @default("to right")
  bgImageKey  String? // site/section-<uuid>.webp
  bgOverlay   Int     @default(0) // 0-80, dark layer over a background image
  headingStyle String @default("accent") // plain | accent | icon | center
  eyebrow      String? // small label above the title: null = the default for this block, "" = none
  accentColor  String? // colour of the label / accent line (null = the brand blue)
  showMore     Boolean? // the "see all" button in the heading: null = the default for this block
  updatedAt  DateTime @updatedAt
}

// ---------- School directory (Anywhere Anytime sites of the district) ----------
model School {
  id            String    @id @default(cuid())
  code          String    @unique // รหัสโรงเรียน (8 digits)
  name          String
  district      String // อำเภอ
  center        String // ศูนย์เครือข่าย
  email         String? // login e-mail of the school account (kept here for the admin list)
  siteUrl       String? // link to the school's Anywhere Anytime site
  cardSourceUrl String? // Google Drive link of the school's card image
  cardKey       String? // stored WebP: schools/<code>-<rand>.webp (public prefix)
  cardStatus    String    @default("none") // none | ok | failed
  cardError     String?
  cardFetchedAt DateTime?
  active        Boolean   @default(true)
  accountId     String?   @unique
  account       User?     @relation("SchoolAccount", fields: [accountId], references: [id], onDelete: SetNull)
  members       User[]    @relation("SchoolMembers")
  registrationCodes RegistrationCode[] @relation("CodeSchool")
  updatedById   String? // last editor (admin or the school itself)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([district, center])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. school.import, school.edit
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// One row per counted attempt (sign-in failure, code guess, sign-up): the limiter counts rows in a time window,
/// so the limit holds across serverless instances. Old rows are swept now and then.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Unique visitors per Bangkok calendar day (one per browser per day, counted by a cookie; nothing personal is stored).
model SiteVisitDaily {
  day      DateTime @id @db.Date
  visitors Int      @default(0)
}

/// "Online now": one row per open tab (random id kept in sessionStorage), refreshed by a heartbeat; rows older than a day are swept.
model OnlinePing {
  sid    String   @id
  seenAt DateTime @default(now())

  @@index([seenAt])
}

/// Directory of outside media sources (other websites / channels) managed by the admin.
model ResourceLink {
  id          String   @id @default(cuid())
  name        String
  url         String
  description String?
  groupName   String   @default("ทั่วไป")
  icon        String   @default("globe")
  color       String   @default("#0052FF")
  // optional own picture instead of the line icon: an uploaded square (iconKey) or a Drive picture with a stored crop window
  iconKey     String?
  iconDriveId String?
  iconCx      Float    @default(0.5)
  iconCy      Float    @default(0.5)
  iconZoom    Float    @default(1)
  iconAspect  Float    @default(1)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([active, sortOrder])
}

/// Editable text pages (about, contact, privacy, terms, help). No row = the built-in default text.
model SitePage {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}
