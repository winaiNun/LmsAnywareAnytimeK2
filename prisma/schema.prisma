generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // app connection (pooled on serverless hosts)
  directUrl = env("DIRECT_URL") // direct connection, used by prisma migrate
}

enum Role {
  ADMIN
  TEACHER
  LIBRARIAN
  STUDENT
}

enum MemberType {
  STUDENT // นักเรียน
  TEACHER // ครู
  SUPERVISOR // ศึกษานิเทศก์
  SCHOOL_ADMIN // ผู้บริหารสถานศึกษา (ผอ./รอง ผอ.)
  DISTRICT_STAFF // ผู้บริหาร/บุคลากรสำนักงานเขต
  GENERAL // บุคคลทั่วไป
}

enum CreatorStatus {
  NONE
  PENDING // asked to become a course creator, waiting for an admin
  APPROVED
  REJECTED
}

model User {
  id                 String            @id @default(cuid())
  email              String?           @unique
  username           String?           @unique // log in without an e-mail (students)
  name               String // full display name (prefix + first + last as typed)
  memberType         MemberType        @default(GENERAL)
  prefix             String? // คำนำหน้า
  firstName          String?
  lastName           String?
  phone              String?
  schoolId           String? // teachers / students pick their school from the directory
  memberSchool       School?           @relation("SchoolMembers", fields: [schoolId], references: [id], onDelete: SetNull)
  organization       String? // supervisors / general: home agency
  position           String? // ตำแหน่ง/วิทยฐานะ
  gradeLevel         String? // students: ชั้น
  creatorStatus      CreatorStatus     @default(NONE)
  creatorReason      String?
  selfPublish        Boolean           @default(false) // an admin trusts this creator: their courses are published without the review queue
  // honours page: a member appears there ONLY after choosing so (opt-in); students never do (enforced in lib/honors.ts)
  showInHonors       Boolean           @default(false)
  honorsShowPhoto    Boolean           @default(true)
  honorsShowSchool   Boolean           @default(true)
  honorsBio          String? // short self-introduction shown on the honours card (<= 140 chars)
  honorsHidden       Boolean           @default(false) // an admin took this member off the honours pages
  devices            TrustedDevice[]
  mediaCreated       Media[]           @relation("MediaCreator")
  mediaLikes         MediaLike[]
  reviewerAreas      AreaReviewer[]
  registrationCodeId String? // the sign-up code this member used (for the per-code member list)
  registrationCode   RegistrationCode? @relation("CodeUsers", fields: [registrationCodeId], references: [id], onDelete: SetNull)
  // profile picture: either an uploaded, already-cropped square (avatarKey) or a public Google Drive file
  // shown through Drive's thumbnail with a stored circular crop window (centre cx/cy 0..1 of the image, zoom >= 1)
  avatarKey          String?
  avatarDriveId      String?
  avatarCx           Float             @default(0.5)
  avatarCy           Float             @default(0.5)
  avatarZoom         Float             @default(1)
  avatarAspect       Float             @default(1) // width / height of the Drive thumbnail
  passwordHash       String
  role               Role              @default(STUDENT)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  enrollments        Enrollment[]
  coursesCreated     Course[]         @relation("CourseCreator")
  quizAttempts       QuizAttempt[]    @relation("QuizAttempts")
  lessonProgress     LessonProgress[] @relation("LessonProgress")
  banners            Banner[]         @relation("BannerCreator")
  school             School?          @relation("SchoolAccount") // set when this account manages a school
  mustChangePassword Boolean          @default(false) // temporary password issued by an admin/import
  certificates       Certificate[]    @relation("UserCertificates")
}

/// Admin-issued sign-up code. Redeemed atomically (see src/lib/registration.ts) so a code with 1 use left
/// can only be used by one of two people signing up at the same moment.
model RegistrationCode {
  id          String     @id @default(cuid())
  code        String     @unique // normalised: upper-case, no dashes
  label       String
  memberType  MemberType
  schoolId    String? // locks the school of everyone who uses the code
  school      School?    @relation("CodeSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  expiresAt   DateTime?
  maxUses     Int? // null = unlimited
  usedCount   Int        @default(0) // sign-ups through THIS code
  groupUsed   Int        @default(0) // on a top-level code: sign-ups through it AND all its sub-codes (what maxUses limits)
  active      Boolean    @default(true)
  parentId    String? // a sub-code (e.g. one per school) of a group code; only two levels
  parent      RegistrationCode?  @relation("CodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    RegistrationCode[] @relation("CodeTree")
  createdById String?
  createdAt   DateTime   @default(now())
  users       User[]     @relation("CodeUsers")

  @@index([active, expiresAt])
  @@index([parentId])
}

/// A phone that signed in with a password once and then chose a 6-digit PIN. The PIN only works together
/// with the random device token kept on that phone (only its hash is stored here).
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  pinHash    String
  failCount  Int      @default(0)
  label      String // e.g. "iPhone · Safari"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ---------- Media library (คลังสื่อ) ----------
enum MediaStatus {
  DRAFT
  PENDING // waiting for a reviewer
  PUBLISHED
  REJECTED
}

enum MediaItemKind {
  YOUTUBE
  DRIVE_FILE // a public Google Drive file (PDF, image, video, office file)
  GOOGLE_DOC // Docs / Slides / Sheets / Forms
  APPS_SCRIPT
  HTML // pasted HTML application, served sandboxed
  EMBED // a provider on the allow-list (Canva, Wordwall, ...)
  LINK // any other https page: opened in a new tab, never framed
  UPLOAD // a file in our storage (only while the admin allows uploads)
}

/// The 8 learning areas + extras. Editable by an admin.
model LearningArea {
  id        String  @id
  slug      String  @unique
  name      String
  cardName  String? // the name with the admin's own line breaks (newline-separated), used on the home cards; null = break automatically
  icon      String  @default("book-open") // icon KEY from src/lib/icon-paths.ts (drawn as a line icon)
  color     String  @default("#0052FF")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media     Media[]
  courses   Course[]
  reviewers AreaReviewer[]
}

model MediaType {
  id        String  @id
  slug      String  @unique
  name      String
  icon      String  @default("file-text")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media Media[]
}

model EducationLevel {
  id        String  @id
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  media   MediaLevel[]
  courses CourseLevel[]
}

model Media {
  id           String       @id @default(cuid())
  title        String
  description  String       @default("")
  authorName   String? // free-text credit when an admin posts on someone else's behalf
  areaId       String
  area         LearningArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  typeId       String?
  type         MediaType?   @relation(fields: [typeId], references: [id], onDelete: SetNull)
  levels       MediaLevel[]
  tags         String[]
  // cover: an uploaded 16:9 WebP, or a public Drive file shown through its thumbnail (focus point = where to crop)
  coverKey     String?
  coverDriveId String?
  coverFx      Float        @default(0.5)
  coverFy      Float        @default(0.5)

  status       MediaStatus @default(DRAFT)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  pinned       Boolean     @default(false)

  createdById String
  createdBy   User   @relation("MediaCreator", fields: [createdById], references: [id], onDelete: Cascade)

  viewCount     Int @default(0)
  likeCount     Int @default(0)
  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        MediaItem[]
  lessonBlocks LessonBlock[]
  likes        MediaLike[]
  views        MediaViewDaily[]

  @@index([status, publishedAt])
  @@index([areaId, status])
  @@index([createdById])
  @@index([status, viewCount])
}

model MediaLevel {
  mediaId String
  levelId String
  media   Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  level   EducationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([mediaId, levelId])
}

/// One thing to open/download. The first item (by sortOrder) is shown in the viewer, the rest are listed as attachments.
model MediaItem {
  id         String        @id @default(cuid())
  mediaId    String
  media      Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind       MediaItemKind
  label      String        @default("")
  url        String? // normalised link (YOUTUBE, DRIVE_FILE, GOOGLE_DOC, APPS_SCRIPT, EMBED, LINK)
  storageKey String? // UPLOAD
  mimeType   String?
  sizeBytes  Int?
  html       String? // HTML (<= 500 KB)
  sortOrder  Int           @default(0)

  @@index([mediaId, sortOrder])
}

model MediaLike {
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([mediaId])
}

/// Views per day: lets "most viewed in the last 30 days" differ from "most viewed ever".
model MediaViewDaily {
  mediaId String
  day     DateTime @db.Date
  views   Int      @default(0)
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, day])
  @@index([day])
}

/// Members the admin appointed to approve media of one learning area.
model AreaReviewer {
  userId String
  areaId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   LearningArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
}

// ---------- LMS ----------
enum CourseStatus {
  DRAFT
  PENDING // waiting for a reviewer
  PUBLISHED
  REJECTED
}

enum LessonRule {
  OPEN // anyone enrolled may open it
  AFTER_PREVIOUS // opens when the lesson before it is done
}

enum BlockKind {
  VIDEO // YouTube (shown in the lesson; watching is not measured)
  LINK // any link the media link parser understands (Drive, Docs, Apps Script, Canva, ...)
  MEDIA // an item of the media library (published ones only)
  TEXT // explanation text (the safe page markup)
  HTML // a pasted HTML app / interactive page, shown in a sandboxed frame (<= 200 KB, see lib/course/blocks.ts)
  QUIZ
}

enum QuestionType {
  SINGLE
  MULTI
  TRUEFALSE
  SHORT
  NUMBER
  MATCH
  ORDER
  CATEGORIZE
  CLOZE
}

enum AnswerReveal {
  NEVER
  AFTER_PASS
  EACH_ATTEMPT
}

enum ProgressStatus {
  NONE
  STARTED
  DONE
}

model Course {
  id             String        @id @default(cuid())
  title          String
  description    String        @default("")
  areaId         String
  area           LearningArea  @relation(fields: [areaId], references: [id], onDelete: Restrict)
  levels         CourseLevel[]
  // cover: an uploaded 16:9 WebP, or a public Drive file shown through its thumbnail (focus point = where to crop)
  coverKey       String?
  coverDriveId   String?
  coverFx        Float         @default(0.5)
  coverFy        Float         @default(0.5)
  instructorName String?
  hours          Float?
  enrollOpen     Boolean       @default(true)
  audienceTypes  MemberType[]  @default([]) // who the course is for (empty = everyone)
  audienceOnly   Boolean       @default(false) // true = only those member types may enrol; false = just recommended to them
  mandatory      Boolean       @default(false) // the audience MUST take this course (listed under "courses I have to take" until finished); never for students
  dueAt          DateTime? // finish by this instant (shown to everyone enrolled); finishing later is still allowed and just marked late

  status       CourseStatus @default(DRAFT)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?

  createdById String
  createdBy   User     @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections           CourseSection[]
  lessons            Lesson[]
  quizzes            Quiz[]
  enrollments        Enrollment[]
  certificateDesigns CertificateDesign[]
  certificates       Certificate[]       @relation("CourseCertificates")

  @@index([status, publishedAt])
  @@index([areaId, status])
  @@index([createdById])
}

model CourseLevel {
  courseId String
  levelId  String
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level    EducationLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([courseId, levelId])
}

model CourseSection {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]

  @@index([courseId, sortOrder])
}

model Lesson {
  id         String         @id @default(cuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title      String
  summary    String         @default("")
  position   Int // order inside the course
  unlockRule LessonRule     @default(OPEN)
  required   Boolean        @default(true) // counts toward finishing the course

  blocks   LessonBlock[]
  progress LessonProgress[]

  @@index([courseId, position])
}

model LessonBlock {
  id        String    @id @default(cuid())
  lessonId  String
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind      BlockKind
  sortOrder Int       @default(0)
  label     String    @default("")
  url       String? // VIDEO / LINK (the link as typed, checked by the media link parser)
  mediaId   String?
  media     Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  text      String? // TEXT
  html      String? // HTML only. Never selected by the lesson page query: the frame loads it from its own route
  quizId    String?
  quiz      Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  required  Boolean   @default(false) // QUIZ only: must be passed to finish the lesson (an "unlock question")

  @@index([lessonId, sortOrder])
}

model Quiz {
  id               String       @id @default(cuid())
  courseId         String
  course           Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  passPercent      Int          @default(60)
  maxAttempts      Int? // null = unlimited
  timeLimitMin     Int? // null = no limit
  shuffleQuestions Boolean      @default(false)
  shuffleChoices   Boolean      @default(true)
  showAnswers      AnswerReveal @default(AFTER_PASS)
  createdAt        DateTime     @default(now())

  questions Question[]
  attempts  QuizAttempt[]
  blocks    LessonBlock[]

  @@index([courseId])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType
  sortOrder   Int          @default(0)
  points      Int          @default(1)
  prompt      String
  imageUrl    String?
  explanation String       @default("")
  config      Json         @default("{}") // what the learner sees (choices, pairs to match, ...)
  answerKey   Json         @default("{}") // the answers; never sent to the browser before submitting

  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("QuizAttempts", fields: [userId], references: [id], onDelete: Cascade)
  seed        Int
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float     @default(0)
  maxScore    Float     @default(0)
  percent     Int       @default(0)
  passed      Boolean   @default(false)
  answers     Json      @default("{}")
  result      Json      @default("{}")

  @@index([quizId, userId])
}

model LessonProgress {
  userId      String
  lessonId    String
  user        User           @relation("LessonProgress", fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NONE)
  confirmed   Boolean        @default(false) // "I have studied this lesson"
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@id([userId, lessonId])
}

model Enrollment {
  id           String    @id @default(cuid())
  userId       String
  courseId     String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress     Int       @default(0) // 0-100, share of the required lessons that are done
  completedAt  DateTime?
  lastLessonId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, courseId])
}

// ---------- Site content ----------
model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  imageKey    String? // storage key, e.g. banners/<uuid>.webp
  linkUrl     String?
  buttonText  String?
  bgColor     String    @default("#EAF0FF")
  showText    Boolean   @default(true) // overlay title/subtitle/button on the image
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  startAt     DateTime?
  endAt       DateTime?
  newTab      Boolean   @default(false) // open the link in a new tab (always true for external links)
  sourceUrl   String? // public Google Drive link the image was taken from (a snapshot is stored)
  pinned      Boolean   @default(false) // admin-only: pinned slides always come first
  published   Boolean   @default(true) // approved by an admin; slides made by others start as false
  createdById String?
  createdBy   User?     @relation("BannerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

// One row (id = "main"): identity of this deployment/district. Another district
// gets its own database (or, later, its own row keyed by area).
model SiteSetting {
  id                      String   @id @default("main")
  systemName              String   @default("Anyware Anytime")
  areaName                String   @default("")
  tagline                 String   @default("")
  logoKey                 String?
  logoBackdrop            Boolean  @default(false) // white rounded plate behind the hero logo
  heroVideoKey            String?
  heroImageKey            String? // still or animated (GIF converted to animated WebP) hero background; exclusive with heroVideoKey
  heroImageAnimated       Boolean  @default(false)
  faqEnabled              Boolean  @default(true) // floating FAQ chat on the public pages
  heroGlobe               Boolean  @default(true) // animated dot-globe over the home banner (follows the pointer)
  honorsEnabled           Boolean  @default(true) // honours page + home section on/off
  honorsMinItems          Int      @default(1) // published media + courses needed to be ranked
  motionLevel             String   @default("light") // scroll-in effects on the home page: off | light | full
  heroGlobeStrength       Int      @default(100) // 20-100: how strong the globe looks (its opacity, in %)
  heroBgColor             String   @default("#0B2A6F") // behind / under the video
  overlayOpacity          Int      @default(45) // 0-90, dark layer over the video
  fadeSeconds             Float    @default(1.5) // video fade in/out at each loop
  // recommended-slides slideshow look
  slideRadius             Int      @default(0) // corner radius px, 0-32 (ignored when full width)
  slideEffect             String   @default("slide") // slide | fade | zoom | wipe | blur
  slideInterval           Float    @default(5) // seconds per slide
  slideLayout             String   @default("contained") // contained | full
  slideAutoplay           Boolean  @default(true)
  slideArrows             Boolean  @default(true)
  slideRandom             Boolean  @default(false) // use every effect, picked at random for each change
  slideShuffle            Boolean  @default(false) // shuffle slide order on each page load (pinned stay first)
  requireRegistrationCode Boolean  @default(true) // sign-up only with an admin-issued code (turn off to allow open sign-up)
  allowServerUploads      Boolean  @default(false) // may members upload images to our storage? (off until there is a server; Drive links work without)
  // footer / contact page
  contactAddress          String?
  contactPhone            String?
  contactEmail            String?
  facebookUrl             String?
  youtubeUrl              String?
  lineUrl                 String?
  // visitor counter
  counterSince            DateTime @default(now()) // "counting since" date shown in the footer (editable)
  counterBase             Int      @default(0) // starting number (e.g. carried over from an older site)
  showVisits              Boolean  @default(true)
  texts                   Json     @default("{}") // admin-edited menu names and page headings (key -> text); missing key = built-in default
  updatedAt               DateTime @updatedAt
}

// Home page blocks below the hero. A row only exists once an admin edits/moves it;
// missing rows fall back to the defaults in src/lib/sections.ts.
model HomeSection {
  key          String   @id // recommended | categories | media | courses
  title        String
  subtitle     String   @default("")
  visible      Boolean  @default(true)
  sortOrder    Int      @default(0)
  align        String   @default("left") // left | center | right (heading position)
  titleSize    String   @default("md") // sm | md | lg
  titleColor   String   @default("#1E1E1E")
  bgColor      String? // solid colour, or gradient start
  bgMode       String   @default("none") // none | solid | gradient | image
  bgColor2     String? // gradient end
  bgDirection  String   @default("to right")
  bgImageKey   String? // site/section-<uuid>.webp
  bgOverlay    Int      @default(0) // 0-80, dark layer over a background image
  headingStyle String   @default("accent") // plain | accent | icon | center
  eyebrow      String? // small label above the title: null = the default for this block, "" = none
  accentColor  String? // colour of the label / accent line (null = the brand blue)
  showMore     Boolean? // the "see all" button in the heading: null = the default for this block
  updatedAt    DateTime @updatedAt
}

// ---------- School directory (Anywhere Anytime sites of the district) ----------
model School {
  id                String             @id @default(cuid())
  code              String             @unique // รหัสโรงเรียน (8 digits)
  name              String
  district          String // อำเภอ
  center            String // ศูนย์เครือข่าย
  email             String? // login e-mail of the school account (kept here for the admin list)
  siteUrl           String? // link to the school's Anywhere Anytime site
  cardSourceUrl     String? // Google Drive link of the school's card image
  cardKey           String? // stored WebP: schools/<code>-<rand>.webp (public prefix)
  cardStatus        String             @default("none") // none | ok | failed
  cardError         String?
  cardFetchedAt     DateTime?
  active            Boolean            @default(true)
  accountId         String?            @unique
  account           User?              @relation("SchoolAccount", fields: [accountId], references: [id], onDelete: SetNull)
  members           User[]             @relation("SchoolMembers")
  registrationCodes RegistrationCode[] @relation("CodeSchool")
  updatedById       String? // last editor (admin or the school itself)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([district, center])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. school.import, school.edit
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// One row per counted attempt (sign-in failure, code guess, sign-up): the limiter counts rows in a time window,
/// so the limit holds across serverless instances. Old rows are swept now and then.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Unique visitors per Bangkok calendar day (one per browser per day, counted by a cookie; nothing personal is stored).
model SiteVisitDaily {
  day      DateTime @id @db.Date
  visitors Int      @default(0)
}

/// Directory of outside media sources (other websites / channels) managed by the admin.
model ResourceLink {
  id          String   @id @default(cuid())
  name        String
  url         String
  description String?
  groupName   String   @default("ทั่วไป")
  icon        String   @default("globe")
  color       String   @default("#0052FF")
  // optional own picture instead of the line icon: an uploaded square (iconKey) or a Drive picture with a stored crop window
  iconKey     String?
  iconDriveId String?
  iconCx      Float    @default(0.5)
  iconCy      Float    @default(0.5)
  iconZoom    Float    @default(1)
  iconAspect  Float    @default(1)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([active, sortOrder])
}

/// Editable text pages (about, contact, privacy, terms, help). No row = the built-in default text.
model SitePage {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

// ---------- Certificates ----------
enum CertificateStatus {
  PENDING // finished the course, waiting for the district to give it a number
  ISSUED
  REVOKED
}

enum CertificateNumberMode {
  MANUAL // an admin presses "issue numbers" for everybody waiting
  AUTO // the learner confirms their name and the next number is given at once
}

/// A running number series ("0001/2569"). One series can serve many courses/designs, so several work groups share one register.
model CertificateSerial {
  id          String                @id @default(cuid())
  name        String
  pattern     String                @default("{no}/{year}") // {no} = running number, {year} = พ.ศ.
  padding     Int                   @default(4)
  nextNo      Int                   @default(1)
  resetYearly Boolean               @default(true)
  lastYear    Int? // พ.ศ. of the last number given (drives the yearly reset)
  mode        CertificateNumberMode @default(MANUAL)
  endNo       Int? // last number of the range the district gave us; null = no limit
  createdAt   DateTime              @default(now())

  designs      CertificateDesign[]
  certificates Certificate[]
}

/// Uploaded by an admin (who confirms the right to use it); the bytes live here so no file storage is needed.
model CertificateFont {
  id          String   @id @default(cuid())
  name        String
  mime        String
  size        Int
  data        Bytes
  createdById String?
  createdAt   DateTime @default(now())
}

/// One certificate layout of a course: the template picture + where each text goes. A course may have several (chosen by score).
model CertificateDesign {
  id           String             @id @default(cuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name         String
  position     Int                @default(0)
  isDefault    Boolean            @default(false)
  minScore     Int? // used for learners whose quiz average reaches this; null = anyone who finishes
  imageDriveId String?
  imageW       Int                @default(0)
  imageH       Int                @default(0)
  fields       Json               @default("[]")
  serialId     String? // null = no number needed, issued the moment the course is finished
  serial       CertificateSerial? @relation(fields: [serialId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  certificates Certificate[]

  @@index([courseId])
}

model Certificate {
  id           String             @id @default(cuid())
  courseId     String
  course       Course             @relation("CourseCertificates", fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  designId     String
  design       CertificateDesign  @relation(fields: [designId], references: [id], onDelete: Restrict)
  serialId     String?
  serial       CertificateSerial? @relation(fields: [serialId], references: [id], onDelete: Restrict)
  number       String?
  status       CertificateStatus  @default(PENDING)
  verifyCode   String             @unique
  completedAt  DateTime
  scorePercent Int?
  nameSnapshot String? // frozen when issued
  issuedAt     DateTime?
  issuedById   String?
  revokedAt    DateTime?
  revokeNote   String?
  createdAt    DateTime           @default(now())

  @@unique([courseId, userId])
  @@unique([serialId, number])
  @@index([courseId, status])
}

/// Question/answer pairs the public FAQ chat answers from. Written by the admin; matching happens in memory.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String // the small safe page markup (see page-markup.ts)
  keywords  String   @default("") // extra words/synonyms people type, comma or space separated
  pinned    Boolean  @default(false) // shown as a starter button when the chat opens
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Questions the chat could not answer, one row per distinct (normalised) question with a counter. No visitor identity is stored.
model FaqUnanswered {
  id      String   @id @default(cuid())
  norm    String   @unique
  sample  String
  count   Int      @default(1)
  status  String   @default("OPEN") // OPEN | DISMISSED | ANSWERED
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  @@index([status, count])
}

/// A tab of the home-page news section (and of /news), e.g. "ข่าวประชาสัมพันธ์", "นโยบาย". Managed by the admin.
model NewsTab {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  pageSize  Int        @default(8) // news per page in this tab (3-30)
  createdAt DateTime   @default(now())
  items     NewsItem[]

  @@index([active, sortOrder])
}

enum NewsItemKind {
  LINK // a title + an outside link, typed by the admin
  FEED // an RSS / Atom feed read on the server (never stored: cached by Next)
}

model NewsItem {
  id           String       @id @default(cuid())
  tabId        String
  tab          NewsTab      @relation(fields: [tabId], references: [id], onDelete: Cascade)
  kind         NewsItemKind
  title        String // LINK: the headline. FEED: the source name shown on its entries
  url          String // LINK: the page. FEED: the feed address
  note         String? // LINK: one short line under the headline
  publishedAt  DateTime? // LINK: shown date (empty = created date)
  pinned       Boolean      @default(false) // LINK only: stays at the top of its tab
  active       Boolean      @default(true)
  feedLimit    Int          @default(20) // FEED: how many of the latest entries to take (5-50)
  feedCacheMin Int          @default(60) // FEED: minutes the fetched entries are cached (15-360)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tabId, active])
}

/// One card of the stat strip under the home banner. `metric` is a key of STAT_METRICS (src/lib/stats/metrics.ts); an empty
/// label / icon means "the default of that metric". The numbers themselves are counted on the server and cached, never stored.
model StatCard {
  id        String   @id @default(cuid())
  metric    String
  label     String?
  icon      String?
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([visible, sortOrder])
}
