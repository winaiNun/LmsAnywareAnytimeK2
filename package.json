{
  "name": "lms-anyware-anytime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d db mailpit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:demo": "tsx prisma/demo.ts",
    "db:demo:clear": "tsx prisma/demo.ts --clear",
    "db:demo:media": "tsx --env-file=.env prisma/demo-media.ts",
    "db:demo:media:clear": "tsx --env-file=.env prisma/demo-media.ts --clear",
    "db:demo:courses": "tsx --env-file=.env prisma/demo-courses.ts",
    "db:demo:courses:clear": "tsx --env-file=.env prisma/demo-courses.ts --clear",
    "db:demo:resources": "tsx --env-file=.env prisma/demo-resources.ts",
    "db:demo:resources:clear": "tsx --env-file=.env prisma/demo-resources.ts --clear",
    "storage:migrate": "tsx scripts/migrate-local-to-s3.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "test:dates": "tsx scripts/test-dates.ts",
    "test:drive": "tsx scripts/test-drive.ts",
    "test": "npm run test:dates && npm run test:drive && npm run test:schools && npm run test:members && npm run test:embed && npm run test:media && npm run test:site && npm run test:course && npm run test:cert && npm run test:quizimport",
    "test:schools": "tsx scripts/test-schools.ts",
    "test:members": "tsx scripts/test-members.ts && tsx scripts/test-users-import.ts",
    "test:embed": "tsx scripts/test-embed.ts",
    "test:media": "tsx scripts/test-media.ts",
    "test:site": "tsx scripts/test-site-pages.ts",
    "test:course": "tsx scripts/test-course.ts",
    "test:cert": "tsx scripts/test-certificate.ts",
    "test:quizimport": "tsx scripts/test-quiz-import.ts",
    "smoke:quizimport": "tsx --env-file=.env scripts/smoke-quiz-import.ts",
    "smoke:cert": "tsx --env-file=.env scripts/smoke-certificate-pages.ts",
    "test:db": "tsx --env-file=.env scripts/test-course-db.ts && tsx --env-file=.env scripts/test-course-learn-db.ts && tsx --env-file=.env scripts/test-course-learners-db.ts && tsx --env-file=.env scripts/test-certificate-db.ts && tsx --env-file=.env scripts/test-quiz-import-db.ts && tsx --env-file=.env scripts/test-site-stats-db.ts && tsx --env-file=.env scripts/test-rate-limit-db.ts && tsx --env-file=.env scripts/test-registration-db.ts && tsx --env-file=.env scripts/test-users-import-db.ts && tsx --env-file=.env scripts/test-media-db.ts && tsx --env-file=.env scripts/test-media-counters-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fontsource/sarabun": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
